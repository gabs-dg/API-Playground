{
  "compilerOptions": {
      "target": "ES2020",
      "module": "esnext",
      "moduleResolution": "bundler",
      "types": [],
      "rootDir": "./src",
      "outDir": "./dist",
      "paths": {
          "@/*": ["./src/*"]
      },

      "strict": true
  },

  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "eslint.config.ts"]
}